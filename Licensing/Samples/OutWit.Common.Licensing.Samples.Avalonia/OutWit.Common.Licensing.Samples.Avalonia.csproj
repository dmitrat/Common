<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>

		<!-- A harness, never a product: not packed, not published, never signed. -->
		<IsPackable>false</IsPackable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Aspects\OutWit.Common.Aspects\OutWit.Common.Aspects.csproj" />
		<ProjectReference Include="..\..\..\MVVM\OutWit.Common.MVVM\OutWit.Common.MVVM.csproj" />
		<!-- For AvaloniaDispatcher alone. The licensing packages know nothing
		     about Avalonia; supplying the thread-marshalling seam is the
		     consumer's job, and this is how a real Avalonia product does it. -->
		<ProjectReference Include="..\..\..\MVVM\OutWit.Common.MVVM.Avalonia\OutWit.Common.MVVM.Avalonia.csproj" />
	</ItemGroup>

	<!--
	The harness is the panel's first consumer, not its last: it binds
	OutWit.Common.Licensing.MVVM before any shipping product does, so the
	abstraction is exercised while it is still free to change.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\OutWit.Common.Licensing\OutWit.Common.Licensing.csproj" />
		<ProjectReference Include="..\..\OutWit.Common.Licensing.MVVM\OutWit.Common.Licensing.MVVM.csproj" />
	</ItemGroup>

	<!--
	The vocabulary generator. Referenced as an analyzer, so the bench's feature
	and limit keys become constants and a typo at a call site is a build error
	rather than a capability that is silently off.

	In-repo this is a ProjectReference with OutputItemType="Analyzer"; a consumer
	outside the repo adds the package and gets the same thing, plus the
	AdditionalFiles convention from its build props.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\OutWit.Common.Licensing.Generator\OutWit.Common.Licensing.Generator.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="bench.product.json" />
	</ItemGroup>

</Project>
