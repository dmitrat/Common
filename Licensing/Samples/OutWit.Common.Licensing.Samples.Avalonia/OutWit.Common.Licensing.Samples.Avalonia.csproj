<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>

		<!-- A harness, never a product: not packed, not published, never signed. -->
		<IsPackable>false</IsPackable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OutWit.Common.Aspects" />
		<PackageReference Include="OutWit.Common.MVVM" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\OutWit.Common.Licensing\OutWit.Common.Licensing.csproj" />
	</ItemGroup>

</Project>
