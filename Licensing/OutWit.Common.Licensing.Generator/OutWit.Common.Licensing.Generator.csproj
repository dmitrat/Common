<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<OutputType>Library</OutputType>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<Nullable>enable</Nullable>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IsAnalyzer>true</IsAnalyzer>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

		<Version>1.0.0</Version>

		<Description>Turns a product's licensing vocabulary into compile-checked constants. One `*.product.json` per product goes in as an AdditionalFile; out come the feature and limit keys as consts and the declaration the runtime needs — so a mistyped feature key is a compiler error instead of a capability that is silently off, and the same file is the descriptor the licence registry imports.</Description>
		<PackageTags>OutWit;Common;Licensing;Licence;License;Generator;SourceGenerator;Vocabulary</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Common/tree/main/Licensing/OutWit.Common.Licensing.Generator</RepositoryUrl>

		<DevelopmentDependency>true</DevelopmentDependency>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IncludeSymbols>false</IncludeSymbols>
		<SymbolPackageFormat></SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="$(OutputPath)\$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="'$(Configuration)' == 'Debug' and Exists('$(OutputPath)\$(AssemblyName).pdb')" />
		<None Include="build\OutWit.Common.Licensing.Generator.props" Pack="true" PackagePath="build" />
	</ItemGroup>

	<Target Name="EnsureBuild" BeforeTargets="Pack" Condition="'$(NoBuild)' != 'true'">
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" />
	</Target>

</Project>
