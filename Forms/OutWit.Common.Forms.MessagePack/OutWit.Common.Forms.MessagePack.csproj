<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
<LangVersion>latest</LangVersion>
<Nullable>enable</Nullable>

<Version>1.0.0</Version>

<Description>Carries OutWit.Common.Forms on a MessagePack wire: one registration, scoped to the form model alone, so a product standardised on MessagePack can send a schema without loosening how anything else of its own is serialised.</Description>
