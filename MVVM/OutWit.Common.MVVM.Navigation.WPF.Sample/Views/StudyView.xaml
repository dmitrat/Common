<UserControl x:Class="OutWit.Common.MVVM.Navigation.WPF.Sample.Views.StudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel>

    <TextBlock Text="{Binding Study.Patient, StringFormat='Study — {0}'}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"
               Text="Transient route: a new view model in its own DI scope on every navigation, disposed when the next screen arrives." />
    <TextBlock Margin="0,8,0,0" Text="{Binding Study.RecordedUtc, StringFormat='recorded {0:yyyy-MM-dd}'}" />

    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,16,0,4" />
    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" />

    <CheckBox IsChecked="{Binding IsDirty}" Margin="0,12,0,0"
              Content="unsaved changes (tick this, then try to leave)" />

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,4" Margin="0,0,8,0" />
      <Button Content="◀ Back" Command="{Binding BackCommand}" Padding="12,4" />
    </StackPanel>

    <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,12,0,0"
               Text="With unsaved changes the screen's guard asks before letting go — the question is a dialog, awaited from inside CanNavigateFromAsync." />

  </StackPanel>

</UserControl>
