<UserControl x:Class="OutWit.Common.MVVM.Navigation.WPF.Sample.Views.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">

  <StackPanel Margin="20">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" />
      <Button Content="Leave anyway" Command="{Binding ConfirmCommand}" Padding="12,4" />
    </StackPanel>
  </StackPanel>

</UserControl>
