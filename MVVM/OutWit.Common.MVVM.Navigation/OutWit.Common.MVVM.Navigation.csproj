<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		net8.0 and up only. The platform packages (Navigation.Avalonia, Navigation.WPF)
		are net8+ anyway and nothing consumes the core without one of them, so the
		older targets would buy nothing and cost polyfills (IsExternalInit,
		Microsoft.Bcl.AsyncInterfaces). These are new packages, not a TFM removal
		from an existing one.
		-->
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<Version>1.1.0</Version>

		<Description>ViewModel-first navigation for MVVM applications: outlets with history, routes, guards, contribution zones for module-supplied menus and nav bars, and typed dialogs — the regions/navigation/dialog part of Prism, without the container, the statics or the region adapters. Platform packages: OutWit.Common.MVVM.Navigation.Avalonia and OutWit.Common.MVVM.Navigation.WPF.</Description>
		<PackageTags>OutWit;Common;MVVM;Navigation;Regions;Dialogs;Prism;Modules</PackageTags>

		<RepositoryUrl>https://github.com/dmitrat/Common/tree/main/MVVM/OutWit.Common.MVVM.Navigation</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OutWit.Common.MVVM.Navigation.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<!--
	Aspects supplies [Notify]; the AspectInjector weave reaches this assembly through
	the package's buildTransitive targets, exactly as it does for Licensing.MVVM.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Common\OutWit.Common\OutWit.Common.csproj" />
		<ProjectReference Include="..\..\Aspects\OutWit.Common.Aspects\OutWit.Common.Aspects.csproj" />
		<ProjectReference Include="..\OutWit.Common.MVVM\OutWit.Common.MVVM.csproj" />
	</ItemGroup>

</Project>
